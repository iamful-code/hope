# Скопируйте в .env в этой же папке (docker compose читает его сам).
# Имя класса стратегии Freqtrade; файл лежит в user_data/strategies/
FT_STRATEGY=SampleStrategy
# Логин/пароль REST API Freqtrade (FreqUI и экспортёр hope)
FT_API_USER=freqtrader
FT_API_PASSWORD=change-me
# Секрет JWT: не меньше 32 символов, не чисто числовой
FT_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
FT_WS_TOKEN=change-me-ws-token
# bot_name Freqtrade (попадает в имя запуска в мониторе: ft:<стратегия>:<bot_name>)
FT_BOT_NAME=hope-ft
# Порт REST API/FreqUI на localhost и период опроса экспортёра, с
FT_API_PORT=8080
FT_EXPORT_INTERVAL=10
MONITOR_PORT=8000
