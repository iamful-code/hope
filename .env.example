# Скопируйте в .env (windows\install.cmd делает это сам) и поправьте при необходимости.
# Формат: KEY=VALUE без пробелов вокруг "=".
STRATEGY_CONFIG=strategies/ft_e0v1en/config.yaml
MONITOR_PORT=8000
# Монитор только для этого компьютера (127.0.0.1) или для локальной сети (0.0.0.0) — используется скриптами windows\*.cmd
MONITOR_HOST=127.0.0.1
# Какие БД показывать в мониторе (через запятую), например data/hope.db,data/bt_queue_mm.db
MONITOR_DB=data/hope.db
# extras для установки и Docker-образа: freqtrade — для веток strategy/ft-*
HOPE_EXTRAS=freqtrade
# Docker: где хранить данные — пусто = ./data (Linux); windows\docker.cmd по умолчанию берёт том hope-data
HOPE_DATA=
