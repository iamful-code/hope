# Командные файлы Windows должны иметь CRLF, иначе cmd.exe неверно разбирает метки и блоки
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# Остальное — LF во всех ОС (Docker-образ собирается в Linux)
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
*.png binary
*.parquet binary
*.db binary
